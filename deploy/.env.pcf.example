# Copy to deploy/.env.pcf and fill in. That file is gitignored and never uploaded: push.ps1
# reads it and sets every key below as an environment variable on the app with cf set-env.
# Print nothing from it by hand; the script prints values masked.

# The address people will use, exactly as it appears in the browser, with no trailing slash.
# It has to match the app's route, and the GitHub OAuth App's callback is built from it.
APP_URL=https://archloom.apps.example.com

# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps on github.com or your GHE).
# Homepage URL:            {APP_URL}
# Authorization callback:  {APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cookie signing. 32+ random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Seals every stored Copilot token in the database. 64 hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this the same for the life of the install. A new key cannot open credentials sealed
# with the old one, and everyone would have to connect their Copilot seat again.
TANDEM_MASTER_KEY=

# Operator access to backup and restore, which is how data survives a push. Long and random.
# Empty turns the admin routes off and leaves push.ps1 with nothing to back up.
TANDEM_ADMIN_TOKEN=

# Optional. read:org lets the runtime see an organisation-assigned Copilot seat, at the cost
# of listing every organisation on the consent screen.
# GITHUB_OAUTH_SCOPES=read:user

# Optional, if the foundation reaches the internet through a proxy. The Copilot CLI honours
# these; the app's own two GitHub calls do not yet (see the README).
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/corporate-root.pem
