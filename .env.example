# Copy to .env at the repo root (the server loads it via dotenv from its working directory,
# so also copy it to server/.env when running `pnpm dev` from the server package).

PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=./data

# Cookie signing secret (32+ random bytes)
SESSION_SECRET=change-me-to-a-long-random-string

# 64 hex chars = 32 bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TANDEM_MASTER_KEY=

# GitHub OAuth App (optional in dev; needed for real GitHub sign-in). Callback: {APP_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 1 = allow "dev login" with any handle (no GitHub needed). Credentials can still be pasted as tokens.
TANDEM_DEV_AUTH=1

# copilot | fake   (fake = offline scripted architect for demos without a Copilot seat)
TANDEM_PROVIDER=copilot
TANDEM_DEFAULT_MODEL=claude-opus-5
TANDEM_MAX_CONCURRENT_TURNS=3
TANDEM_BATCH_WINDOW_MS=1500
TANDEM_APPROVAL_TIMEOUT_S=60
